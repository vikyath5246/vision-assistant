# Required: Get an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=api_key_goes_here
# Optional: OpenAI model (gpt-4o-mini is cheapest with vision support)
# Other options: gpt-4o (higher quality, more expensive)
OPENAI_MODEL=gpt-4o-mini

# Optional: STT model size (tiny=39MB, base=74MB, small=244MB)
# "base" is recommended: good accuracy, fast on CPU
# "tiny" if you need the fastest startup and lowest memory usage
WHISPER_MODEL_SIZE=base

# Optional: TTS voice (see https://www.microsoft.com/en-us/edge/features/read-aloud)
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%

# Optional: Database URL (SQLite by default, no setup required)
DATABASE_URL=sqlite:///./vision_assistant.db
